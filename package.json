{
  "name": "effindom-fui-cs-repo",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only OR LicenseRef-EffinDom-Commercial",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "build": "npm run prepare:runtime && npm --prefix v2/fui-cs run build",
    "test": "npm run test:unit",
    "test:unit": "npm --prefix v2/fui-cs run test:unit",
    "test:integration": "npm run build && playwright test -c v2/fui-cs/playwright.config.ts",
    "typecheck": "npm --prefix v2/fui-cs run typecheck",
    "serve": "http-server public -p 8080"
  },
  "dependencies": {
    "@effindomv2/runtime": "^0.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.1",
    "http-server": "14.1.1",
    "typescript": "^5.9.3"
  }
}
