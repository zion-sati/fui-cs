<Project Sdk="NetWasm.Sdk">

  <!-- One TUnit project, two lanes: desktop .NET (dotnet run -f net11.0) for fast runs, and
       NetWasm (dotnet test -f netwasm0.1) to catch compiler-specific behavior. -->
  <PropertyGroup>
    <TargetFrameworks>netwasm0.1;net11.0</TargetFrameworks>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- NetWasm.TUnit 0.10.6 is built from upstream TUnit v1.75.0; the desktop lane pins the same version. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netwasm0.1'">
    <PackageReference Include="NetWasm.TUnit" Version="0.10.6" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="TUnit" Version="1.75.0" />
  </ItemGroup>

  <!-- The workbench route's reorder math is plain C#, tested here without the route. -->
  <ItemGroup>
    <Compile Include="..\..\demo\AdvancedControls\Reorder\ReorderDemoLogic.cs" Link="Demo\ReorderDemoLogic.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FuiCs\FuiCs.csproj" />
    <ProjectReference Include="..\..\src\FuiCs.Worker\FuiCs.Worker.csproj" />
    <ProjectReference Include="..\..\demo\DesignSystem\FuiCs.Demo.DesignSystem.csproj" />
  </ItemGroup>

</Project>
