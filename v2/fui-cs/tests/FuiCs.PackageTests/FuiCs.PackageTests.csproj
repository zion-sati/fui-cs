<Project Sdk="Microsoft.NET.Sdk">

  <!-- The package test under dotnet test (not part of the solution's tests, since it packs and builds two applications
       from scratch): packs the fui-cs packages, creates an application from each template in a temporary folder with
       its own template registry, NuGet cache and a feed of just the new packages beside nuget.org, publishes it with
       dotnet publish alone, and checks it in Chromium (tests/package). Nothing is installed for the user or pushed. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.75.0" />
  </ItemGroup>

</Project>
