{
  "name": "@effindomv2/fui-cs",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only OR LicenseRef-EffinDom-Commercial",
  "type": "module",
  "scripts": {
    "check:generated": "bash scripts/dotnet.sh build FuiCs.slnx -p:FuiCsCheckGenerated=true",
    "generate:docs": "bash scripts/generate-docs.sh",
    "check:docs": "bash scripts/generate-docs.sh --check",
    "check:examples": "bash scripts/check-doc-examples.sh",
    "build": "bash scripts/build.sh",
    "pack": "bash scripts/pack.sh",
    "test:package": "bash scripts/test-package.sh",
    "test:unit": "bash scripts/test-unit.sh",
    "test:unit:desktop": "bash scripts/test-unit.sh desktop",
    "test:unit:netwasm": "bash scripts/test-unit.sh netwasm",
    "test:browser": "bash scripts/dotnet.sh test tests/FuiCs.BrowserTests/FuiCs.BrowserTests.csproj",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "^24.10.1",
    "esbuild": "^0.27.7",
    "typescript": "^5.9.3"
  }
}
